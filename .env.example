BOT_TOKEN=123456:your_token_here
ADMIN_ID=123456789
DB_URL=sqlite+aiosqlite:///./nodes.db
# Оставьте пустыми, если хотите получать всё в ADMIN_ID
ALERT_CHAT_ID=
SUMMARY_CHAT_ID=
# 0 отключает подавление повторных DOWN-алертов
ALERT_REPEAT_MINUTES=15
POLL_TICK_SECONDS=1
SUMMARY_INTERVAL_HOURS=1
CHEBURCHECK_INTERVAL_HOURS=6
CHEBURCHECK_STARTUP_DELAY_SEC=10
CHEBURCHECK_TIMEOUT_SEC=10
CHEBURCHECK_REQUEST_DELAY_SEC=2.1
CHEBURCHECK_API_TOKEN=
CHEBURCHECK_BASE_URL=https://cheburcheck.ru/api/v1

# Автообновление (host-updater, не внутри контейнера)
DEPLOY_DIR=/opt/node-monitor-bot
BACKUP_DIR=/opt/node-monitor-bot/backups
GITHUB_REPO=HakunaMaruna/node-monitor-bot
GITHUB_TOKEN=
INCLUDE_ENV=1
CHECK_INTERVAL_SEC=3600
FETCH_COMMAND=git fetch --tags --force
UPDATE_COMMAND=docker compose pull && docker compose up -d --force-recreate --remove-orphans
STOP_COMMAND=docker compose down
ROLLBACK_START_COMMAND=docker compose build && docker compose up -d --force-recreate --remove-orphans
